{
  "schema_version": 4,
  "portfolio_project": "Rocksmith Song DLC Generator",
  "repository": "jweter/rocksmith-cdlc-generator",
  "repository_role": "standalone",
  "source_of_truth": "GitHub repository state plus authoritative documents listed below",
  "authoritative_documents": [
    "docs/project-status.yaml",
    "docs/agent-development-policy.md",
    "docs/INDUSTRY_REALITY_CHECK.md",
    "PROJECT_PLAN.md",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "definition_of_done": {
    "implementation_complete": true,
    "tests_required_for_change_scope": true,
    "current_required_ci_green": true,
    "mergeability_resolved": true,
    "blocking_reviews_and_comments_resolved": true,
    "architecture_security_licensing_provenance_privacy_clear": true,
    "documentation_updated_when_project_reality_changes": true,
    "regression_protection_for_reproduced_bugs": "when practical",
    "product_reality": "pre-merge only when explicitly documented; otherwise track as post-merge acceptance debt"
  },
  "invariants": [
    "no_live_rocksmith_modification",
    "no_commercial_audio_dlc_ubisoft_derived_private_generated_workspaces_or_private_reference_material_in_git",
    "human_authority_for_uncertain_musical_judgment",
    "bass_lead_rhythm_first_class",
    "provenance_preserved"
  ],
  "verification": {
    "automated_lanes": [
      "ci",
      "windows_desktop",
      "security",
      "synthetic_golden_song",
      "regression_fixtures"
    ],
    "product_reality_lanes": [
      "packaged_windows_app",
      "real_rocksmith_import_playback",
      "human_timing_fingering_tone_review"
    ],
    "rule": "never convert missing human evidence into PASS; keep implementation status separate from Product Reality acceptance",
    "executable_lanes": [
      {
        "id": "golden_song_v1",
        "steps": [
          [
            "python",
            "-m",
            "pytest",
            "tests/test_printed_notation_authoring.py",
            "tests/test_eof_export_boundary_check.py",
            "tests/test_shared_guitar_timeline.py",
            "tests/test_guitarpro_import.py",
            "tests/test_rocksmith_xml.py",
            "tests/test_reviewed_rocksmith_xml.py",
            "-q"
          ]
        ],
        "evidence": "Repository-safe synthetic notation, arrangement/timeline, technique import, and Rocksmith XML export regression"
      }
    ]
  },
  "work_ownership": {
    "authority": "GitHub",
    "active_work_sources": [
      "open pull requests",
      "open issues with active implementation evidence",
      "recent focused branches/commits when attributable"
    ],
    "rule": "do not duplicate or compete with active work; prefer finishing existing work"
  },
  "regression_memory": {
    "path": "engineering/regression-memory.json",
    "rule": "record significant or recurring reproduced failures with root cause, fix, verification, regression protection, and residual risk"
  },
  "readiness_scoring": {
    "mode": "evidence-derived",
    "prohibit_guessed_percent_complete": true,
    "dimensions": [
      "implementation",
      "automated_verification",
      "integration",
      "product_reality",
      "documentation",
      "security_and_policy"
    ],
    "rule": "report unknown when evidence is insufficient"
  },
  "continuation": "derive from project status, roadmap/issues, and highest-value unblocked Product Reality or defect lane",
  "cross_repo_authorities": [],
  "portfolio_aggregation": {
    "project_key": "rocksmith-cdlc",
    "component_role": "standalone",
    "required_components": [
      "standalone"
    ],
    "authority": "hourly portfolio orchestrator",
    "rule": "aggregate only verified repository evidence; never infer missing component state"
  },
  "golden_scenarios": [
    {
      "id": "golden-song-v1",
      "component": "standalone",
      "lane": "golden_song_v1",
      "rule": "automated scenario covers repository-safe synthetic authoring; packaged/gameplay and musical judgment remain separate Product Reality evidence"
    }
  ],
  "preflight": {
    "required_before_pr": true,
    "evidence_file": "preflight-evidence.json",
    "format_apply": null,
    "checks": [
      {
        "id": "control_plane",
        "argv": [
          "python",
          "engineering/validate_control_plane.py"
        ],
        "kind": "governance",
        "fast": true
      },
      {
        "id": "regression_memory",
        "argv": [
          "python",
          "engineering/validate_regression_memory.py"
        ],
        "kind": "governance",
        "fast": true
      },
      {
        "id": "automation_readiness",
        "argv": [
          "python",
          "scripts/check_automation_readiness.py"
        ],
        "kind": "governance",
        "fast": true
      },
      {
        "id": "compile",
        "argv": [
          "python",
          "-m",
          "compileall",
          "-q",
          "src",
          "tests",
          "engineering"
        ],
        "kind": "quality",
        "fast": true
      },
      {
        "id": "tests",
        "argv": [
          "python",
          "-m",
          "pytest",
          "-q"
        ],
        "kind": "test",
        "fast": false
      },
      {
        "id": "cli",
        "argv": [
          "cdlc",
          "--help"
        ],
        "kind": "smoke",
        "fast": false
      },
      {
        "id": "golden",
        "argv": [
          "python",
          "engineering/run_verification.py",
          "--lane",
          "golden_song_v1"
        ],
        "kind": "golden",
        "fast": false
      }
    ],
    "policy": "ordinary PRs require GREEN full preflight evidence on the exact head; use PREFLIGHT_UNVERIFIED only for a legitimate environment limitation and record the reason"
  },
  "promotion": {
    "states": [
      "IMPLEMENTING",
      "PREFLIGHT_UNVERIFIED",
      "PREFLIGHT_GREEN",
      "PR_OPEN",
      "CI_PENDING",
      "GREEN",
      "MERGED",
      "PRODUCT_REALITY_PENDING",
      "PRODUCT_REALITY_VERIFIED"
    ],
    "rule": "advance only from verified evidence; never skip FAILED/PENDING/UNCERTAIN gates"
  }
}
